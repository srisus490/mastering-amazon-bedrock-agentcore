# Environment variables for File Monitoring System (SQLite - $0 Cost!)
# Copy this file to .env and update values as needed

# SQLite Database Configuration (Completely FREE - no server needed!)
DATABASE_PATH=data/file_monitoring.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
SERVICE_NAME=file-monitoring

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# JWT Configuration (for API authentication)
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Amazon Bedrock AI Configuration
# Enable/disable AI features (set to false to disable AI insights)
AI_ENABLED=true

# AWS Bedrock region (default: us-east-1)
BEDROCK_REGION=us-east-1

# Bedrock model ID (Claude 3 Sonnet recommended for quality and cost balance)
# Options:
#   - anthropic.claude-3-sonnet-20240229-v1:0 (recommended, ~$3-15 per million tokens)
#   - anthropic.claude-3-haiku-20240307-v1:0 (cheaper, faster, less capable)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Bedrock request timeout in seconds (default: 30)
BEDROCK_TIMEOUT=30

# Maximum tokens for AI responses (default: 4000)
# Higher values = more detailed insights but higher cost
BEDROCK_MAX_TOKENS=4000

# Temperature for AI responses (0.0-1.0, default: 0.7)
# Lower = more focused, Higher = more creative
BEDROCK_TEMPERATURE=0.7

# Cache TTL for AI insights (in seconds)
# Smart Insights cache (default: 3600 = 1 hour)
AI_CACHE_TTL_INSIGHTS=3600

# Forecast cache (default: 21600 = 6 hours)
AI_CACHE_TTL_FORECAST=21600

# Root Cause Analysis cache (default: 3600 = 1 hour)
AI_CACHE_TTL_ROOT_CAUSE=3600

# AWS Credentials (use IAM roles in production, or set these for local development)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=your-session-token (if using temporary credentials)

# Amazon Bedrock Knowledge Base Configuration
# Knowledge Base ID from AWS Console (leave empty to disable KB retrieval)
KNOWLEDGE_BASE_ID=
# AWS region where Knowledge Base is deployed
KNOWLEDGE_BASE_REGION=us-east-1
# Maximum number of documents to retrieve per query (default: 5)
KB_MAX_RESULTS=5
# Minimum similarity score threshold (0.0-1.0, default: 0.7)
KB_SIMILARITY_THRESHOLD=0.7


# Bedrock Agent Configuration (for intelligent agentic AI)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=TSTALIASID
